# Stock Buddy — local development
DATABASE_URL=file:data/stockbuddy.sqlite

# Data MCP (optional HTTP mode)
STOCK_BUDDY_DATA_HTTP=0
STOCK_BUDDY_DATA_PORT=8081

# Enable admin ingest tools on data MCP
STOCK_BUDDY_DATA_ADMIN=1

# Web dashboard (market data explorer)
STOCK_BUDDY_DASHBOARD_PORT=3000

# DSE TLS: dsebd.org uses an incomplete certificate chain (handled automatically in scraper)

# Analysis MCP (existing)
STOCK_BUDDY_HTTP=0
STOCK_BUDDY_SKILLS_DIR=./skills
# Persist analyze_ticker results to analysis_snapshots when DATABASE_URL is set
STOCK_BUDDY_PERSIST_ANALYSIS=1

# Advisory mode (default on): direct actionable language for real investment decisions.
# Set to 0 or educational for demo/education-only disclaimers and softened phrasing.
STOCK_BUDDY_ADVISORY_MODE=1

# Multi-source ingest (comma-separated; disable sources for debugging or compliance)
INGEST_FUNDAMENTALS_SOURCES=dse,stockanalysis,stockanalysis_statistics,lankabd,amarstock
INGEST_OHLCV_SOURCES=dse,stockanalysis,yahoo
# Daily worker OHLCV lookback (calendar days; 90 ≈ 60+ DSE trading bars)
INGEST_DAILY_OHLCV_DAYS=90
INGEST_NEWS_SOURCES=dse_psn,dse_corporate,tbs_stocks,dhaka_tribune_stock,tbs_economy,financial_express,google_news_dse,daily_star_business,tbs_economy_bn,prothomalo,google_news_bn,financial_express_bn
# Optional: public Telegram channel RSS bridges (comma-separated URLs)
# INGEST_NEWS_TELEGRAM_RSS=https://rsshub.app/telegram/channel/your_public_channel
# Optional: extra RSS feeds (comma-separated) — e.g. Jugantor/Kaler Kantho/Jagonews often block bots; use a public RSS bridge if needed
# INGEST_NEWS_CUSTOM_RSS=
INGEST_SOURCE_RATE_MS=1000
