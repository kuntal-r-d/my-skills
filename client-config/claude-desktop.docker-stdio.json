{
  "mcpServers": {
    "stock-buddy-data": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/Developer/projects/stock-buddy-skill-mcp/stock-buddy/data:/data",
        "-e",
        "STOCK_BUDDY_DATA_HTTP=0",
        "-e",
        "DATABASE_URL=file:/data/stockbuddy.sqlite",
        "-e",
        "STOCK_BUDDY_DATA_ADMIN=1",
        "stock-buddy-mcp:latest",
        "node",
        "packages/data-mcp-server/dist/server.js"
      ]
    },
    "stock-buddy": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/Developer/projects/stock-buddy-skill-mcp/stock-buddy/data:/data",
        "-e",
        "STOCK_BUDDY_HTTP=0",
        "-e",
        "DATABASE_URL=file:/data/stockbuddy.sqlite",
        "-e",
        "STOCK_BUDDY_SKILLS_DIR=/app/skills",
        "stock-buddy-mcp:latest"
      ]
    }
  }
}
